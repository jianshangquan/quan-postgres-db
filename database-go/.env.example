# Copy to .env and fill in before docker compose up.
# docker compose --env-file .env up --build
# Generate TLS material first: ./certs/gen-certs.sh

QUAN_STORAGE_TOKEN=change-me-to-a-long-random-secret
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_USER=postgres
POSTGRES_DB=app
TENANT_ID=default
TIMELINE_ID=main
QUORUM=2

# Optional overrides (compose defaults use HTTPS + cert mounts):
# QUAN_PAGESERVER_HTTP_URLS=https://pageserver:8081,https://pageserver-2:8081
# QUAN_TLS_CA=./certs/ca.crt
